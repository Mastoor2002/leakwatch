{
    "name": "leakwatch/agent",
    "description": "Reports a Laravel app's installed Composer packages to Leakwatch so it can alert on new security advisories.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Leakwatch\\Agent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Leakwatch\\Agent\\AgentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
